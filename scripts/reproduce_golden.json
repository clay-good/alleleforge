      "models": [
        {
          "chemistry": "base_abe",
          "citation": "AlleleForge contributors (heuristic); mechanism after Marquart et al. 2021 (BE-DICT)",
          "intended_use": "A deterministic, dependency-free default base-editing window-outcome prior (which editable bases are edited and the bystander spectrum). For the published BE-DICT outcome use the opt-in trained model (be-dict). Research use.",
          "known_failure_modes": [
            "Transparent motif heuristic, not the trained BE-DICT model: a re-run from this checkpoint reproduces the heuristic, not published BE-DICT numbers. Use be-dict for the trained model.",
            "Treats editable positions as independent and does not model deaminase- and context-dependent bystander transfer."
          ],
          "license": "MIT",
          "name": "be-dict-baseline",
          "out_of_scope_use": "Trusting the outcome as the trained BE-DICT prediction (it is a transparent heuristic); clinical decision-making; chemistries other than base editing.",
          "sha256": null,
          "version": "0.1"
        },
        {
          "chemistry": "prime",
          "citation": "AlleleForge contributors (heuristic); mechanism after Mathis et al. 2023/2024 (PRIDICT2.0)",
          "intended_use": "A deterministic, dependency-free default that exercises the calibrated- uncertainty and OOD plumbing end to end and gives a reasonable geometry-based ranking prior. For published PRIDICT2.0 efficiency use the opt-in trained model (pridict2). Research use.",
          "known_failure_modes": [
            "Transparent geometry heuristic, not the trained PRIDICT2.0 model (method=HEURISTIC): a re-run from this checkpoint reproduces the heuristic, not published PRIDICT2.0 numbers. Use pridict2 for the trained model.",
            "Cell-context OOD is flagged from the HEK293T/K562 window, but the score itself does not model chromatin without ePRIDICT + an ENCODE track.",
            "No edit-size or edit-class feature: two pegRNAs with identical geometry score identically whether they write one base or a 29-nt insertion, which the RTT-length penalty only indirectly proxies. A score for a non-single-base edit carries an explicit note saying so; use the trained pridict2 model for size-aware numbers."
          ],
          "license": "MIT",
          "name": "pridict2-baseline",
          "out_of_scope_use": "Trusting the point estimate as the trained PRIDICT2.0 prediction (it is a transparent heuristic); clinical decision-making; a substitute for experimental validation.",
          "sha256": null,
          "version": "0.1"
        },
        {
          "chemistry": "prime",
          "citation": "AlleleForge contributors (heuristic); byproduct channels after Anzalone et al. 2019 (prime editing)",
          "intended_use": "A deterministic, dependency-free default for the intended-vs-byproduct distribution and the intended probability that feeds the menu's cleanliness objective. Research use.",
          "known_failure_modes": [
            "Transparent geometry heuristic, not a trained byproduct model: a re-run from this checkpoint reproduces the heuristic, not measured product distributions.",
            "Keyed on pegRNA geometry only \u2014 no target-sequence context, no cell type, and no edit-size or edit-class term, so two pegRNAs with identical geometry receive the same split whether they write one base or a 29-nt insertion.",
            "The three modeled byproduct channels (scaffold incorporation, partial RT product, indel) are the dominant ones, not an exhaustive account of what a pegRNA can produce."
          ],
          "license": "MIT",
          "name": "prime-outcome-baseline",
          "out_of_scope_use": "Trusting the byproduct split as a measured product distribution (it is a transparent heuristic); clinical decision-making; a substitute for sequencing the edited product.",
          "sha256": null,
          "version": "0.1"
        }
